# Copy to .env.test. Loaded by `npm test` instead of .env.
#
# This MUST be a database the suite is allowed to truncate. Pointing it at the
# development database means a test run deletes your own work, which is why it
# is a separate file rather than a flag.
#
# With Neon, the cleanest separate database is a BRANCH of the main one, not a
# second project: it starts as a copy of the schema, has its own connection
# string, and can be reset without touching your development data. Use that
# branch's direct (unpooled) string here.
DATABASE_URL=

# Any value will do here; the tests do not verify a real signature.
JWT_SECRET=
