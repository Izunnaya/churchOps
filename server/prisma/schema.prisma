// Church Operations Platform — data model
//
// Derived from design/DESIGN-SPEC.md. Two rules from the brief shape this
// schema more than anything else:
//
//   1. "The treasurer never types a total, at any level." No computed total is
//      ever stored. Category cash totals derive from DenominationCount rows,
//      offering totals derive from their categories, and bucket deductions
//      derive from IncomeCategory.bucketRatePercent. Storing them would let a
//      stale total outlive the counts behind it.
//   2. "A late transfer creates a revision, never an overwrite." Finalized
//      offerings are never mutated in place; OfferingRevision records what
//      changed, who changed it, when and why.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum ChurchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

/// One independent church. Several share this application and this database,
/// and a church user can never reach or discover another one.
///
/// Every church-owned model carries a required `churchId` pointing here. The
/// account models — User and its roles, sessions and tokens — deliberately do
/// not, until DEC-02 decides whether an account belongs to one church or can
/// span several.
///
/// A foreign key is not isolation on its own. Nothing yet forces a query to
/// filter on it: that is the scoping middleware in slice 0.7, and the tests that
/// prove it in 0.9.
model Church {
  id   String @id @default(cuid())
  /// Not unique. Two unrelated churches may legitimately share a name; `slug`
  /// is the handle that has to be distinct.
  name String
  slug String @unique

  status ChurchStatus @default(ACTIVE)

  /// Identity belongs to the church that owns it. None of this is ever a
  /// fallback for another church, including in PDFs and notifications.
  /// A null logo means the interface draws an initials mark instead.
  logoFileId String?
  /// A named palette, not editable colours: "crest" or "default".
  accentSet  String  @default("default")

  /// Which parts of the product this church has. Whether this is church-editable
  /// configuration or a platform-set entitlement is undecided — Build Spec
  /// section 17, proposed DEC-17.
  enabledModules String[]

  timezone String @default("Africa/Lagos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Money and audit rows restrict the delete rather than cascade with it: one
  // `DELETE FROM "Church"` must not be able to take approved offerings,
  // revisions and the audit trail that proved they existed. `status: CLOSED` is
  // the mechanism for a church leaving; what leaving means for retention,
  // export and deletion is not decided yet. Build Spec section 17 proposes a
  // decision for it, but a proposal is not an adopted decision, so this does
  // not cite its number.
  // Every church-owned model, back-referenced. Account models (User and its
  // tokens and roles) are deliberately absent until DEC-02 decides whether an
  // account belongs to one church or spans several.
  members                Member[]
  departments            Department[]
  departmentMembers      DepartmentMember[]
  services               Service[]
  attendanceRecords      AttendanceRecord[]
  attendanceSummaries    AttendanceSummary[]
  offerings              Offering[]
  offeringCategories     OfferingCategory[]
  denominationCounts     DenominationCount[]
  offeringRevisions      OfferingRevision[]
  incomeCategories       IncomeCategory[]
  weeklyFinancialReports WeeklyFinancialReport[]
  weeklyExpenses         WeeklyExpense[]
  expenseItems           ExpenseItem[]
  approvalComments       ApprovalComment[]
  departmentReports      DepartmentReport[]
  memberImports          MemberImport[]
  memberImportRows       MemberImportRow[]
  notifications          Notification[]
  auditEvents            AuditEvent[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

enum Role {
  TREASURER
  SECRETARY
  PASTOR
  DEPARTMENT_LEADER
  USHER
}

/// A department leader self-registers and stays inactive until the Secretary
/// approves. The other four roles are seeded directly — there is only ever one
/// of each, so the brief deliberately gives them no signup screen.
enum UserStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String
  username     String     @unique
  passwordHash String
  status       UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?     @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers   User[]    @relation("UserApprovals")
  disabledAt      DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles    UserRole[]
  sessions Session[]

  emailTokens    EmailVerificationToken[]
  passwordTokens PasswordResetToken[]

  notifications Notification[]
  auditEvents   AuditEvent[]
  comments      ApprovalComment[]

  membersAdded         Member[]                @relation("MemberAddedBy")
  servicesCreated      Service[]               @relation("ServiceCreatedBy")
  attendanceMarked     AttendanceRecord[]      @relation("AttendanceMarkedBy")
  attendanceCompiled   AttendanceSummary[]     @relation("AttendanceCompiledBy")
  offeringsRecorded    Offering[]              @relation("OfferingRecordedBy")
  offeringsFinalized   Offering[]              @relation("OfferingFinalizedBy")
  offeringsApproved    Offering[]              @relation("OfferingApprovedBy")
  revisionsRecorded    OfferingRevision[]      @relation("RevisionRecordedBy")
  categoriesMaintained IncomeCategory[]        @relation("IncomeCategoryUpdatedBy")
  reportsPrepared      WeeklyFinancialReport[] @relation("FinancialReportPreparedBy")
  reportsApproved      WeeklyFinancialReport[] @relation("FinancialReportApprovedBy")
  expensesPrepared     WeeklyExpense[]         @relation("ExpensePreparedBy")
  expensesApproved     WeeklyExpense[]         @relation("ExpenseApprovedBy")
  deptReportsSubmitted DepartmentReport[]      @relation("DeptReportSubmittedBy")
  deptReportsReviewed  DepartmentReport[]      @relation("DeptReportReviewedBy")
  importsUploaded      MemberImport[]          @relation("ImportUploadedBy")
  importRowsResolved   MemberImportRow[]       @relation("ImportRowResolvedBy")

  @@index([status])
}

/// Roles are a list, not a column: the brief gives the Treasurer and Department
/// Leader a role switcher, so one person can hold several. departmentId is set
/// only for DEPARTMENT_LEADER.
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, role, departmentId])
  @@index([role])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// A 6-digit code is only 10^6 guesses. Without a counter, an unauthenticated
  /// caller can walk the whole space and verify an account that is not theirs.
  /// Build Spec section 6 caps it at five.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Church membership
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

/// An usher adds a first-timer on the spot with only a name and phone, so
/// almost every field here has to be optional. The Secretary later converts
/// them to MEMBER from the Visitors screen.
enum MemberKind {
  MEMBER
  FIRST_TIMER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Member {
  id        String       @id @default(cuid())
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  sex       Sex?
  phone     String?
  email     String?
  address   String?
  kind      MemberKind   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)

  joinedAt    DateTime?
  firstSeenAt DateTime?
  convertedAt DateTime?
  notes       String?

  addedById String?
  addedBy   User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance  AttendanceRecord[]
  departments DepartmentMember[]
  importRows  MemberImportRow[]  @relation("ImportRowResolvedMember")
  duplicateOf MemberImportRow[]  @relation("ImportRowDuplicateOf")

  // Attendance capture must find a known member in under 5 seconds, so the
  // search index carries the name columns the usher actually types into.
  @@unique([churchId, id])
  @@index([lastName, firstName])
  @@index([kind, status])
  @@index([phone])
  @@index([churchId])
}

model Department {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaders UserRole[]
  members DepartmentMember[]
  reports DepartmentReport[]

  @@unique([churchId, name])
  @@unique([churchId, id])
  @@index([churchId])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  churchId     String
  church       Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [churchId, departmentId], references: [churchId, id], onDelete: Cascade)
  memberId     String
  member       Member     @relation(fields: [churchId, memberId], references: [churchId, id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([departmentId, memberId])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Services and attendance
// ---------------------------------------------------------------------------

/// The Secretary creates the one-off events — Mount Carmel, conventions,
/// vigils — that do not fit the fixed weekly rhythm.
enum ServiceKind {
  SUNDAY_FIRST
  SUNDAY_SECOND
  MIDWEEK
  VIGIL
  CONVENTION
  SPECIAL
}

model Service {
  id       String      @id @default(cuid())
  churchId String
  church   Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name     String
  kind     ServiceKind
  heldOn   DateTime    @db.Date

  createdById String?
  createdBy   User?   @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance AttendanceRecord[]
  summary    AttendanceSummary?
  offering   Offering?

  @@unique([churchId, heldOn, kind])
  @@unique([churchId, id])
  @@index([heldOn])
  @@index([churchId])
}

enum AttendanceSource {
  USHER
  SECRETARY
}

model AttendanceRecord {
  id        String  @id @default(cuid())
  churchId  String
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [churchId, serviceId], references: [churchId, id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [churchId, memberId], references: [churchId, id], onDelete: Cascade)

  source     AttendanceSource @default(USHER)
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime         @default(now())

  /// Set when the row arrived from the usher's offline queue rather than live,
  /// so a replayed mark is distinguishable from one made at the door.
  capturedOfflineAt DateTime?

  @@unique([serviceId, memberId])
  @@index([serviceId])
  @@index([memberId])
  @@index([churchId])
}

/// The Secretary's compiled headcount for a service. Per-member marks and the
/// compiled figures are one system, not two: the compiled row is a snapshot the
/// Secretary confirms, and headcounts that were never marked by name (children,
/// for instance) live only here.
model AttendanceSummary {
  id        String  @id @default(cuid())
  churchId  String
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [churchId, serviceId], references: [churchId, id], onDelete: Cascade)

  men         Int @default(0)
  women       Int @default(0)
  children    Int @default(0)
  firstTimers Int @default(0)

  compiledById String?
  compiledBy   User?     @relation("AttendanceCompiledBy", fields: [compiledById], references: [id], onDelete: SetNull)
  compiledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, serviceId])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Offering — category-first
// ---------------------------------------------------------------------------

enum OfferingStatus {
  DRAFT
  FINALIZED
  APPROVED
  REVISED
}

model Offering {
  id        String  @id @default(cuid())
  churchId  String
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Restrict)
  serviceId String
  service   Service @relation(fields: [churchId, serviceId], references: [churchId, id], onDelete: Cascade)

  status OfferingStatus @default(DRAFT)
  notes  String?

  recordedById String?
  recordedBy   User?   @relation("OfferingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  finalizedById String?
  finalizedBy   User?     @relation("OfferingFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("OfferingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories OfferingCategory[]
  revisions  OfferingRevision[]
  comments   ApprovalComment[]

  @@unique([churchId, id])
  @@unique([churchId, serviceId])
  @@index([status])
  @@index([churchId])
}

/// Each category carries its own denomination count, because Tithe and Worship
/// Offering arrive in their own envelopes and are counted separately. Transfer
/// categories (Seed Faith, Special Offering, Donations) have no cash behind
/// them and hold a flat transferAmount instead.
///
/// There is no `total` column by design. A cash category's total is
/// SUM(denomination * quantity) over its DenominationCount rows.
model OfferingCategory {
  id         String   @id @default(cuid())
  churchId   String
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Restrict)
  offeringId String
  offering   Offering @relation(fields: [churchId, offeringId], references: [churchId, id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  /// false = transfer with no physical cash, so no denomination breakdown.
  isCash Boolean @default(true)

  /// The bucket rate that applied when this offering was finalized, frozen into
  /// the row. Rates are treasurer-editable and categories can be renamed or
  /// retired, so reading the live table would let a change in June rewrite a
  /// figure the Pastor approved in March. Null while the offering is a draft,
  /// and null for a category the rate table did not cover.
  bucketRateSnapshot Decimal? @db.Decimal(5, 2)

  /// Set only when isCash is false. Cash categories leave this null and derive
  /// their total from the counts.
  transferAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  denominations DenominationCount[]

  @@unique([offeringId, name])
  @@unique([churchId, id])
  @@index([offeringId])
  @@index([churchId])
}

/// One row per note value the treasurer counted for a category, e.g.
/// denomination 1000, quantity 23.
model DenominationCount {
  id         String           @id @default(cuid())
  churchId   String
  church     Church           @relation(fields: [churchId], references: [id], onDelete: Restrict)
  categoryId String
  category   OfferingCategory @relation(fields: [churchId, categoryId], references: [churchId, id], onDelete: Cascade)

  denomination Int
  quantity     Int @default(0)

  @@unique([categoryId, denomination])
  @@index([categoryId])
  @@index([churchId])
}

/// A late transfer after finalization. The original figures stay on the
/// offering's categories; this records the delta so both the original and the
/// revised total can be shown side by side, with who, when and why.
model OfferingRevision {
  id         String   @id @default(cuid())
  churchId   String
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Restrict)
  offeringId String
  offering   Offering @relation(fields: [churchId, offeringId], references: [churchId, id], onDelete: Cascade)

  reason String

  /// Supplied by the client and unique per offering, so a double tap or a retry
  /// on a dropped connection resolves to the revision already written instead
  /// of recording the same late transfer twice. Build Spec section 16.4 requires
  /// one on every finalize, submit, approve and revision endpoint; finalize and
  /// approve are incidentally covered by their own status guards, a revision is
  /// not, because a revised offering stays revisable.
  idempotencyKey String

  categoryName String?
  deltaAmount  Decimal @db.Decimal(14, 2)

  /// Snapshotted so the revision stays readable even if categories change later.
  originalTotal Decimal @db.Decimal(14, 2)
  revisedTotal  Decimal @db.Decimal(14, 2)

  recordedById String?
  recordedBy   User?    @relation("RevisionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime @default(now())

  @@unique([offeringId, idempotencyKey])
  @@index([offeringId])
  @@index([churchId])
}

/// The treasurer-maintainable category list, and the bucket rate table the
/// corrections doc asks for, in one place — a separate rate table keyed by name
/// would drift out of step with the category names it is meant to match.
///
/// The deduction itself is never stored: it is amount * bucketRatePercent,
/// computed at read time.
model IncomeCategory {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  name     String

  /// Seed Faith, Special Offering and Donations default to transfer.
  isCashByDefault Boolean @default(true)

  /// Percentage set aside into the contingency bucket, e.g. 10.00 for Tithe,
  /// 40.00 for Missionary Offering. Null means this category is not bucketed.
  bucketRatePercent Decimal? @db.Decimal(5, 2)

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  updatedById String?
  updatedBy   User?   @relation("IncomeCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Financial reporting
// ---------------------------------------------------------------------------

enum FinancialReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// Which offerings belong to a week is derived from Service.heldOn falling
/// inside [weekStart, weekEnd], so a revision recorded later is picked up
/// without touching this row.
model WeeklyFinancialReport {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Restrict)
  weekStart DateTime @db.Date
  weekEnd   DateTime @db.Date

  status FinancialReportStatus @default(DRAFT)

  /// The WhatsApp report this replaces carries explanations and an approval
  /// request, so the generated report has to support prose, not only tables.
  narrative String?

  preparedById String?
  preparedBy   User?     @relation("FinancialReportPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  submittedAt  DateTime?

  approvedById String?
  approvedBy   User?     @relation("FinancialReportApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ApprovalComment[]

  @@unique([churchId, weekStart])
  @@unique([churchId, id])
  @@index([status])
  @@index([churchId])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model WeeklyExpense {
  id        String        @id @default(cuid())
  churchId  String
  church    Church        @relation(fields: [churchId], references: [id], onDelete: Restrict)
  weekStart DateTime      @db.Date
  weekEnd   DateTime      @db.Date
  status    ExpenseStatus @default(DRAFT)
  notes     String?

  preparedById String?
  preparedBy   User?     @relation("ExpensePreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  submittedAt  DateTime?

  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    ExpenseItem[]
  comments ApprovalComment[]

  @@unique([churchId, weekStart])
  @@unique([churchId, id])
  @@index([status])
  @@index([churchId])
}

model ExpenseItem {
  id        String        @id @default(cuid())
  churchId  String
  church    Church        @relation(fields: [churchId], references: [id], onDelete: Restrict)
  expenseId String
  expense   WeeklyExpense @relation(fields: [churchId, expenseId], references: [churchId, id], onDelete: Cascade)

  name      String
  amount    Decimal @db.Decimal(14, 2)
  note      String?
  sortOrder Int     @default(0)

  @@index([expenseId])
  @@index([churchId])
}

/// Lets the Pastor raise a question without it counting as approval or
/// rejection, on either approval surface. Visible to whoever submitted.
/// Exactly one of the four targets is set.
model ApprovalComment {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  financialReportId String?
  financialReport   WeeklyFinancialReport? @relation(fields: [churchId, financialReportId], references: [churchId, id], onDelete: Cascade)

  weeklyExpenseId String?
  weeklyExpense   WeeklyExpense? @relation(fields: [churchId, weeklyExpenseId], references: [churchId, id], onDelete: Cascade)

  offeringId String?
  offering   Offering? @relation(fields: [churchId, offeringId], references: [churchId, id], onDelete: Cascade)

  departmentReportId String?
  departmentReport   DepartmentReport? @relation(fields: [churchId, departmentReportId], references: [churchId, id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([financialReportId])
  @@index([weeklyExpenseId])
  @@index([offeringId])
  @@index([departmentReportId])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Department reports
// ---------------------------------------------------------------------------

enum ReportKind {
  WEEKLY
  QUARTERLY
}

/// Editable after submission only until the Secretary begins review. Once
/// UNDER_REVIEW or APPROVED, the leader edits again only after a RETURNED.
enum DepartmentReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED
}

model DepartmentReport {
  id           String     @id @default(cuid())
  churchId     String
  church       Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [churchId, departmentId], references: [churchId, id], onDelete: Cascade)

  kind        ReportKind
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date

  status DepartmentReportStatus @default(DRAFT)

  // Weekly shape
  attendanceCount Int?
  offeringAmount  Decimal? @db.Decimal(14, 2)
  visitorCount    Int?

  // Quarterly shape — prose rather than numbers
  achievements String?
  projections  String?
  challenges   String?

  submittedById String?
  submittedBy   User?     @relation("DeptReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  reviewedById String?
  reviewedBy   User?     @relation("DeptReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  returnNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ApprovalComment[]

  @@unique([departmentId, kind, periodStart])
  @@unique([churchId, id])
  @@index([status])
  @@index([departmentId, kind])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Member register import
// ---------------------------------------------------------------------------

/// Rows the import could not take as-is are "set aside" for the Secretary to
/// resolve one at a time, rather than failing the whole import.
enum ImportRowStatus {
  READY
  DUPLICATE
  MISSING_SEX
  MISSING_NAME
  IMPORTED
  SKIPPED
  MERGED
}

model MemberImport {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  fileName String

  uploadedById String?
  uploadedBy   User?   @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  rows MemberImportRow[]

  @@unique([churchId, id])
  @@index([churchId])
}

model MemberImportRow {
  id        String       @id @default(cuid())
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  importId  String
  import    MemberImport @relation(fields: [churchId, importId], references: [churchId, id], onDelete: Cascade)
  rowNumber Int

  rawFirstName String?
  rawLastName  String?
  rawSex       String?
  rawPhone     String?

  status ImportRowStatus @default(READY)

  duplicateOfMemberId String?
  duplicateOfMember   Member? @relation("ImportRowDuplicateOf", fields: [duplicateOfMemberId], references: [id], onDelete: SetNull)

  resolvedMemberId String?
  resolvedMember   Member? @relation("ImportRowResolvedMember", fields: [resolvedMemberId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?     @relation("ImportRowResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@index([churchId])
}

// ---------------------------------------------------------------------------
// Notifications and audit
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  WHATSAPP
}

/// An in-app record of what the WhatsApp reminders already sent, so anyone can
/// look back. linkPath is the deep link the message pointed at — every core
/// screen has to work as a direct landing point.
model Notification {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel  NotificationChannel @default(IN_APP)
  title    String
  body     String
  linkPath String?

  sentAt DateTime  @default(now())
  readAt DateTime?

  @@index([userId, sentAt])
  @@index([churchId])
}

/// Backs the "who recorded the change, when, and the reason" trail the offering
/// and report screens display.
model AuditEvent {
  id       String  @id @default(cuid())
  churchId String
  church   Church  @relation(fields: [churchId], references: [id], onDelete: Restrict)
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([churchId])
}
