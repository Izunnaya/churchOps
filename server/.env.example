# Copy to .env and fill in. .env is gitignored and must stay that way:
# this repository is public and has never held a real credential.

# Postgres. Any Postgres works; this project uses Neon.
#
# Use Neon's DIRECT (unpooled) connection string, not the pooled one. Prisma
# runs migrations in a session that holds advisory locks, and a pooled
# connection can hand successive statements to different backends, which makes
# `prisma migrate` fail in ways that look random. The pooled string is the one
# with `-pooler` in the host; the direct string is the one without it.
#
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Signs session tokens. No default exists on purpose: a shared fallback secret
# is worse than a server that refuses to sign. Generate one with
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=

# The browser origin allowed to call this server, e.g. the deployed frontend.
# Several are allowed, separated by commas. Left empty, it falls back to the
# Vite dev server at http://localhost:5173, which is what local work needs.
CORS_ORIGIN=

# Optional. The server falls back to the value in brackets.
# PORT                  [4000]
# ACCESS_TOKEN_TTL      [15m]
# REFRESH_TOKEN_TTL_DAYS [30]
